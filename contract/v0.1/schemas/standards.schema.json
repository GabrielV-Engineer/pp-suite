{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pp-suite:contract:0.1:standards",
  "title": "Standards (.sddpp/standards.yaml)",
  "description": "How this project handles security, observability, git, CI and the experience of whoever uses it. Each standard is adopted with a choice, deferred until a trigger, or not needed, by a person. Optional file, written by `ppc decide-standard`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["standards"],
  "properties": {
    "standards": { "type": "array", "items": { "$ref": "#/$defs/standard" } }
  },
  "$defs": {
    "trigger": {
      "enum": ["git_remote", "ci_config", "backend_component", "database_component", "infra_component"],
      "description": "What asks again: the repository gets a remote, a CI configuration appears, or the design gets a component of that kind."
    },
    "answer": {
      "type": "object",
      "properties": {
        "decision": { "enum": ["pending", "adopt", "later", "not_needed"] },
        "choice": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
        "details": { "type": "string", "minLength": 5, "description": "For a custom choice: the rule or tool, in the person's words. Optional otherwise." },
        "trigger": { "$ref": "#/$defs/trigger" },
        "reason": { "type": "string", "minLength": 5, "description": "Why it is not needed, or why it waits." },
        "decided_by": { "type": "string", "minLength": 1 },
        "decided_on": { "type": "string", "format": "date" }
      },
      "allOf": [
        { "if": { "properties": { "decision": { "enum": ["adopt", "later", "not_needed"] } }, "required": ["decision"] }, "then": { "required": ["decided_by", "decided_on"] } },
        { "if": { "properties": { "decision": { "const": "adopt" } }, "required": ["decision"] }, "then": { "required": ["choice"] }, "else": { "not": { "required": ["choice"] } } },
        { "if": { "properties": { "decision": { "const": "later" } }, "required": ["decision"] }, "then": { "required": ["trigger"] }, "else": { "not": { "required": ["trigger"] } } },
        { "if": { "properties": { "decision": { "const": "not_needed" } }, "required": ["decision"] }, "then": { "required": ["reason"] } },
        { "if": { "properties": { "choice": { "const": "custom" } }, "required": ["choice"] }, "then": { "required": ["details"] } }
      ]
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decision"],
      "properties": {
        "id": { "enum": ["security", "observability", "git", "ci", "experience"] },
        "decision": true,
        "choice": true,
        "details": true,
        "trigger": true,
        "reason": true,
        "decided_by": true,
        "decided_on": true,
        "history": {
          "type": "array",
          "description": "Earlier decisions, oldest first. A change never erases why it was decided before.",
          "items": {
            "type": "object",
            "allOf": [{ "$ref": "#/$defs/answer" }],
            "required": ["decision"],
            "unevaluatedProperties": false
          }
        }
      },
      "allOf": [
        { "$ref": "#/$defs/answer" },
        { "if": { "properties": { "id": { "const": "security" } } }, "then": { "properties": { "choice": { "enum": ["basic", "strict", "custom"] } } } },
        { "if": { "properties": { "id": { "const": "observability" } } }, "then": { "properties": { "choice": { "enum": ["errors", "logs-metrics", "custom"] } } } },
        { "if": { "properties": { "id": { "const": "experience" } } }, "then": { "properties": { "choice": { "enum": ["glance", "review", "external", "custom"] } } } },
        { "if": { "properties": { "id": { "const": "git" } } }, "then": { "properties": { "choice": { "enum": ["trunk", "branch-per-slice", "branch-per-slice-pr", "custom"] }, "decision": { "not": { "const": "not_needed" } } } } },
        { "if": { "properties": { "id": { "const": "ci" } } }, "then": { "properties": { "choice": { "enum": ["local", "github", "gitlab", "custom"] }, "decision": { "not": { "const": "not_needed" } } } } }
      ]
    }
  }
}
