{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pp-suite:contract:0.1:slice",
  "title": "Slice (.sddpp/slices/SL-NNN-*.md frontmatter)",
  "description": "A thin vertical cut: one observable behavior through the layers it needs. Every WBS leaf is a slice.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "type", "status", "blueprint_revision", "components"],
  "properties": {
    "id": { "type": "string", "pattern": "^SL-\\d{3,}$" },
    "title": { "type": "string", "minLength": 5 },
    "type": { "enum": ["skeleton", "feature", "refactor", "spike", "fix"] },
    "status": { "enum": ["planned", "ready", "in_progress", "done", "dropped"] },
    "blueprint_revision": { "type": "integer", "minimum": 1 },
    "capability": { "type": "string", "pattern": "^CAP-\\d{3}$" },
    "quality_attributes": { "type": "array", "items": { "type": "string", "pattern": "^QA-\\d{3}$" }, "uniqueItems": true },
    "components": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "uniqueItems": true },
    "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^SL-\\d{3,}$" }, "uniqueItems": true },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenario"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-\\d+$" },
          "scenario": { "type": "string", "minLength": 15 },
          "audience": { "enum": ["user", "system"], "description": "Who could see this criterion being met. `system` means nobody who uses the thing could (CI, the build, an internal check): the look-at list and the guide for someone else leave it out. Without it the criterion is shown; pp-suite does not guess from the words." }
        }
      }
    },
    "test_policy": { "enum": ["required", "optional", "none"], "description": "Overrides the blueprint test policy for this slice." },
    "screens": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^SCR-\\d{2,}$" }, "description": "The screens of .architect/ui.md this slice builds to; it is built to their approved mockups and checked against them." },
    "pays": { "type": "array", "items": { "type": "string", "pattern": "^DEBT-[A-Z]{2,5}-\\d{3,}$" }, "uniqueItems": true },
    "approved_by": { "type": "string", "minLength": 1, "description": "Human who approved this slice to start." },
    "mode": { "enum": ["light", "strict"], "description": "The cycle this slice follows. Light: build tests and code together, no approval of tests, no lock. Strict: red tests approved by a human, then green with the tests locked. `ppc start` records the mode it applied; without one the slice is checked as strict." },
    "phase": { "enum": ["red", "green", "refactor", "build"] },
    "red_approved_by": { "type": "string", "minLength": 1, "description": "Human who approved the RED tests before GREEN began." },
    "timebox_hours": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 },
    "disposable": { "type": "boolean" },
    "outcome": { "type": "string", "minLength": 10, "description": "What a spike learned." },
    "glanced_by": { "type": "string", "minLength": 1, "description": "Human who looked at what the closed slice built, as a user would meet it (the experience standard). Written by `ppc glance`." },
    "glanced_on": { "type": "string", "format": "date" },
    "glance_skipped": { "const": true, "description": "The person decided not to look at this one; recorded, and not asked again." },
    "closed_on": { "type": "string", "format": "date", "description": "The day `ppc finish` closed the slice. Slices closed before this field existed have none." },
    "audit": { "$ref": "#/$defs/audit" }
  },
  "$defs": {
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commits", "production_lines", "test_lines", "tests_added", "mutation_score", "decisions", "debt_created", "deviations"],
      "properties": {
        "commits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha", "kind"],
            "properties": {
              "sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
              "kind": { "enum": ["red", "green", "refactor", "build", "structural", "docs"] }
            }
          }
        },
        "production_lines": { "type": "integer", "minimum": 0, "description": "Lines changed in hand-written production code. This is what the budget counts." },
        "test_lines": { "type": "integer", "minimum": 0, "description": "Lines changed in test files. Informational: it is what a reviewer reads." },
        "tests_added": { "type": "integer", "minimum": 0 },
        "mutation_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "decisions": { "type": "array", "items": { "type": "string", "pattern": "^ADR-\\d{4}$" } },
        "debt_created": { "type": "array", "items": { "type": "string", "pattern": "^DEBT-[A-Z]{2,5}-\\d{3,}$" } },
        "deviations": { "type": "array", "items": { "type": "string", "minLength": 3 } },
        "debt_paid": { "type": "array", "items": { "type": "string", "pattern": "^DEBT-[A-Z]{2,5}-\\d{3,}$" }, "uniqueItems": true, "description": "The debt in `pays` this slice paid." },
        "tools": {
          "type": "array",
          "description": "For each role the slice called for that had a tool adopted: whether the tool was used, from the record the hook keeps. `used` is null when nothing was recorded for the slice. `reason` is the agent's, for a tool it did not use.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "tool", "kind", "used"],
            "properties": {
              "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "tool": { "type": "string", "minLength": 2 },
              "kind": { "enum": ["skill", "plugin", "mcp"] },
              "used": { "type": ["boolean", "null"] },
              "reason": { "type": "string", "minLength": 5, "pattern": "^[^\\r\\n]+$" }
            },
            "allOf": [{ "if": { "properties": { "used": { "const": false } }, "required": ["used"] }, "else": { "not": { "required": ["reason"] } } }]
          }
        },
        "suite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "failed"],
          "description": "How the whole test suite ran at the close; a failure goes with a proposed test debt entry.",
          "properties": { "command": { "type": "string", "minLength": 3 }, "failed": { "type": "integer", "minimum": 0 } }
        },
        "ui_check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "console_errors", "screenshots"],
          "description": "How the audit opened the real app of a slice with screens: the command, the console errors, and the screenshots it wrote (or why there are none).",
          "properties": {
            "command": { "type": "string", "minLength": 3 },
            "console_errors": { "type": "integer", "minimum": 0 },
            "screenshots": { "type": "array", "items": { "type": "string", "pattern": "^\\.sddpp/ui-checks/" } },
            "no_screenshots_reason": { "type": "string", "minLength": 10 },
            "notes": { "type": "string" }
          }
        },
        "measurements": {
          "type": "array",
          "minItems": 1,
          "description": "What the audit measured against the slice's quality targets, with the command the project declared (the experience standard). `met` is the auditor's reading of the target; ppc does not judge it.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["qa", "command", "value", "met"],
            "properties": {
              "qa": { "type": "string", "pattern": "^QA-\\d{3}$" },
              "command": { "type": "string", "minLength": 3 },
              "value": { "type": "string", "minLength": 1 },
              "met": { "type": "boolean" },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        },
        "debt_unpaid": {
          "type": "array",
          "description": "The debt in `pays` this slice did not pay, and why; that debt is open again.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason"],
            "properties": { "id": { "type": "string", "pattern": "^DEBT-[A-Z]{2,5}-\\d{3,}$" }, "reason": { "type": "string", "minLength": 10 } }
          }
        },
        "budget_override_reason": { "type": "string", "minLength": 10 },
        "mutation_override_reason": { "type": "string", "minLength": 10 }
      }
    }
  },
  "dependentRequired": { "glanced_by": ["glanced_on"], "glanced_on": ["glanced_by"], "glance_skipped": ["glanced_by"] },
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["skeleton", "feature", "fix"] } }, "required": ["type"] },
      "then": { "required": ["acceptance"], "properties": { "acceptance": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "type": { "const": "feature" } }, "required": ["type"] },
      "then": { "required": ["capability"] }
    },
    {
      "if": { "properties": { "type": { "const": "refactor" } }, "required": ["type"] },
      "then": { "required": ["pays"], "properties": { "pays": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "type": { "const": "spike" } }, "required": ["type"] },
      "then": { "required": ["timebox_hours", "disposable"], "properties": { "disposable": { "const": true } } }
    },
    {
      "if": { "properties": { "status": { "enum": ["ready", "in_progress", "done"] } }, "required": ["status"] },
      "then": { "required": ["approved_by"] }
    },
    {
      "if": { "properties": { "status": { "const": "in_progress" } }, "required": ["status"] },
      "then": { "required": ["phase"] }
    },
    {
      "if": { "properties": { "status": { "const": "done" }, "type": { "enum": ["skeleton", "feature", "fix", "refactor"] } }, "required": ["status", "type"] },
      "then": { "required": ["audit"] }
    },
    {
      "if": { "properties": { "status": { "const": "done" }, "type": { "enum": ["skeleton", "feature", "fix"] }, "mode": { "not": { "const": "light" } } }, "required": ["status", "type"] },
      "then": { "required": ["red_approved_by"] }
    },
    {
      "if": { "properties": { "status": { "const": "done" }, "type": { "const": "spike" } }, "required": ["status", "type"] },
      "then": { "required": ["outcome"] }
    },
    {
      "if": { "properties": { "phase": { "enum": ["green", "refactor"] }, "type": { "enum": ["skeleton", "feature", "fix"] }, "mode": { "not": { "const": "light" } } }, "required": ["phase", "type"] },
      "then": { "required": ["red_approved_by"] }
    }
  ]
}
