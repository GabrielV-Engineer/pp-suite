{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pp-suite:contract:0.1:slice",
  "title": "Slice (.sddpp/slices/SL-NNN-*.md frontmatter)",
  "description": "A thin vertical cut: one observable behavior through the layers it needs. Every WBS leaf is a slice.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "type", "status", "blueprint_revision", "components"],
  "properties": {
    "id": { "type": "string", "pattern": "^SL-\\d{3,}$" },
    "title": { "type": "string", "minLength": 5 },
    "type": { "enum": ["skeleton", "feature", "refactor", "spike", "fix"] },
    "status": { "enum": ["planned", "ready", "in_progress", "done", "dropped"] },
    "blueprint_revision": { "type": "integer", "minimum": 1 },
    "capability": { "type": "string", "pattern": "^CAP-\\d{3}$" },
    "quality_attributes": { "type": "array", "items": { "type": "string", "pattern": "^QA-\\d{3}$" }, "uniqueItems": true },
    "components": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "uniqueItems": true },
    "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^SL-\\d{3,}$" }, "uniqueItems": true },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenario"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-\\d+$" },
          "scenario": { "type": "string", "minLength": 15 }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "story"],
      "description": "Where the user story this slice delivers is written. The story must be a heading in that file (T15).",
      "properties": {
        "file": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+\\.md$", "description": "Relative path of a Markdown file inside the project." },
        "story": { "type": "string", "minLength": 2, "description": "The start of the story's heading, for example \"User Story 1\"." }
      }
    },
    "pays": { "type": "array", "items": { "type": "string", "pattern": "^DEBT-[A-Z]{2,5}-\\d{3,}$" }, "uniqueItems": true },
    "approved_by": { "type": "string", "minLength": 1, "description": "Human who approved this slice to start." },
    "phase": { "enum": ["red", "green", "refactor"] },
    "red_approved_by": { "type": "string", "minLength": 1, "description": "Human who approved the RED tests before GREEN began." },
    "timebox_hours": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 },
    "disposable": { "type": "boolean" },
    "outcome": { "type": "string", "minLength": 10, "description": "What a spike learned." },
    "audit": { "$ref": "#/$defs/audit" }
  },
  "$defs": {
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commits", "production_lines", "test_lines", "tests_added", "mutation_score", "decisions", "debt_created", "deviations"],
      "properties": {
        "commits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha", "kind"],
            "properties": {
              "sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
              "kind": { "enum": ["red", "green", "refactor", "structural", "docs"] }
            }
          }
        },
        "production_lines": { "type": "integer", "minimum": 0, "description": "Lines changed in hand-written production code. This is what the budget counts." },
        "test_lines": { "type": "integer", "minimum": 0, "description": "Lines changed in test files. Informational: it is what a reviewer reads." },
        "tests_added": { "type": "integer", "minimum": 0 },
        "mutation_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "decisions": { "type": "array", "items": { "type": "string", "pattern": "^ADR-\\d{4}$" } },
        "debt_created": { "type": "array", "items": { "type": "string", "pattern": "^DEBT-[A-Z]{2,5}-\\d{3,}$" } },
        "deviations": { "type": "array", "items": { "type": "string", "minLength": 3 } },
        "budget_override_reason": { "type": "string", "minLength": 10 },
        "mutation_override_reason": { "type": "string", "minLength": 10 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["skeleton", "feature", "fix"] } }, "required": ["type"] },
      "then": { "required": ["acceptance"], "properties": { "acceptance": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "type": { "const": "feature" } }, "required": ["type"] },
      "then": { "required": ["capability"] }
    },
    {
      "if": { "properties": { "type": { "const": "refactor" } }, "required": ["type"] },
      "then": { "required": ["pays"], "properties": { "pays": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "type": { "const": "spike" } }, "required": ["type"] },
      "then": { "required": ["timebox_hours", "disposable"], "properties": { "disposable": { "const": true } } }
    },
    {
      "if": { "properties": { "status": { "enum": ["ready", "in_progress", "done"] } }, "required": ["status"] },
      "then": { "required": ["approved_by"] }
    },
    {
      "if": { "properties": { "status": { "const": "in_progress" } }, "required": ["status"] },
      "then": { "required": ["phase"] }
    },
    {
      "if": { "properties": { "status": { "const": "done" }, "type": { "enum": ["skeleton", "feature", "fix", "refactor"] } }, "required": ["status", "type"] },
      "then": { "required": ["audit"] }
    },
    {
      "if": { "properties": { "status": { "const": "done" }, "type": { "enum": ["skeleton", "feature", "fix"] } }, "required": ["status", "type"] },
      "then": { "required": ["red_approved_by"] }
    },
    {
      "if": { "properties": { "status": { "const": "done" }, "type": { "const": "spike" } }, "required": ["status", "type"] },
      "then": { "required": ["outcome"] }
    },
    {
      "if": { "properties": { "phase": { "enum": ["green", "refactor"] }, "type": { "enum": ["skeleton", "feature", "fix"] } }, "required": ["phase", "type"] },
      "then": { "required": ["red_approved_by"] }
    }
  ]
}
